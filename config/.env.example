# Google to M365 Migration - Parameter Reference
# The migration controller takes parameters directly - it does NOT read this file.
# Copy the values you use into your automation / RMM command line.

# === Google Workspace ===
# Google Workspace Super Admin Email (required for domain-wide delegation)
GOOGLE_ADMIN_EMAIL=admin@yourdomain.com

# Path to Google service account JSON key (auto-discovered in Downloads/Desktop/cwd if omitted)
GOOGLE_KEY_PATH=C:\Users\YourName\Downloads\gws-migration-key.json

# === Microsoft 365 ===
# Target Delivery Domain (M365) - use a verified routing subdomain, NOT onmicrosoft.com
TARGET_DELIVERY_DOMAIN=o365.contoso.com

# Migration Batch Name
BATCH_NAME=GoogleWorkspaceMigration

# Migration Endpoint Name
ENDPOINT_NAME=GoogleWorkspaceEndpoint

# === Migration CSV ===
# Path to migration CSV (auto-discovered as migration-users.csv if omitted)
MIGRATION_CSV_PATH=C:\Users\YourName\Downloads\migration-users.csv

# === Monitoring ===
# Monitoring interval in seconds (15-3600)
MONITOR_INTERVAL_SECONDS=60

# Max monitor minutes (1-1440)
MAX_MONITOR_MINUTES=60

# === Safety ===
# Users to test Google delegation against (0-500)
DELEGATION_TEST_COUNT=3

# Keep the service-account key file after use (default: securely shredded)
KEEP_KEY_FILE=false

# Skip the live Google delegation test
SKIP_GOOGLE_TEST=false

# Fail fast instead of prompting (for RMM/SYSTEM)
NON_INTERACTIVE=false