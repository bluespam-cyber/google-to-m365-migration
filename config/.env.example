# Google to M365 Migration - Environment Variables
# Copy this file to .env and fill in your values

# Google Workspace Super Admin Email
GOOGLE_ADMIN_EMAIL=admin@yourdomain.com

# Target Delivery Domain (M365)
TARGET_DELIVERY_DOMAIN=yourdomain.onmicrosoft.com

# Migration Batch Name
BATCH_NAME=Google_To_M365_AutoBatch

# Migration Endpoint Name
ENDPOINT_NAME=GoogleWorkspaceEndpoint

# Path to Google Service Account JSON key
GOOGLE_KEY_PATH=C:\Users\YourName\Downloads\gsuite-migration-key.json

# Path to migration CSV (optional - auto-detected if omitted)
MIGRATION_CSV_PATH=C:\Users\YourName\Downloads\migration-users.csv

# Monitoring interval in seconds
MONITOR_INTERVAL_SECONDS=45
